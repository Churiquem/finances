# ==============================================================================
# Finances — Exemplo de Variáveis de Ambiente
# ==============================================================================
# NOTA (v1.0 - Modo Local/Offline):
# Nenhuma variável abaixo é obrigatória para executar o projeto localmente.
# Na v1.0, o aplicativo opera 100% no navegador (localStorage) por padrão.
#
# Caso deseje testar a camada opcional de persistência remota (Roadmap v2.0),
# copie este arquivo para `.env.local` e preencha com suas credenciais.
# ==============================================================================

# Credenciais do Supabase (Opcional na v1.0)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Porta padrão para execução standalone / container (ex: Docker / Cloud Run)
PORT=8080
